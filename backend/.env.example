# Maidora Kenya gateway — environment template.
# Copy real values into .env on the server (never commit .env).

PORT=3000
NODE_ENV=production

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_POOL=5

# Auth
JWT_SECRET=change-me-64-hex-chars

# TalkSasa SMS (OTP delivery)
SMS_API_URL=https://bulksms.talksasa.com/api/v3
SMS_API_TOKEN=your_talksasa_token
SMS_SENDER_ID=TALK-SASA

# OTP
OTP_TTL_MINUTES=10
# 11-char Android SMS Retriever hash (expo-otp-autofill getAppHashAsync()).
# Appended to OTP SMS so the app can auto-fill the code on Android.
OTP_APP_HASH=

# ─── M-Pesa Configuration (Daraja, production — STK Push live) ───
MPESA_PROD_BUSINESS_SHORTCODE=5511376
MPESA_PROD_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_PROD_PARTY_B=9393975
MPESA_PROD_CONSUMER_KEY=your_consumer_key
MPESA_PROD_CONSUMER_SECRET=your_consumer_secret
MPESA_PROD_PASSKEY=your_passkey
# Public HTTPS endpoint that receives Safaricom's result callback.
MPESA_CALLBACK_URL=https://your-domain/api/payments/callback
# Appears on the customer's M-Pesa statement (max 12 chars)
MPESA_ACCOUNT_REFERENCE=Maidora
